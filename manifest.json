{
  "manifest_version": 3,
  "name": "My First Extension",
  "version": "1.0.0",
  "description": "My first chrome extension",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup.html"
  }
}
